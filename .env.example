# Copy this file to .env and keep credentials local.
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Select independently: mock | cloudflare | gemini | wan | ace-step
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
MUSIC_PROVIDER=mock
NARRATION_PROVIDER=mock
SCRIPT_PROVIDER=gemini

CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# Optional downloaded outputs from Kaggle notebooks
KAGGLE_WAN_OUTPUT_DIR=
ACE_STEP_OUTPUT=

REQUEST_TIMEOUT_SECONDS=120
REQUEST_RETRIES=3
