{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage short storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "creative_direction", "characters", "shots", "audio", "end_card"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "duration_seconds", "language", "subtitle_language", "aspect_ratios"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "number", "minimum": 60, "maximum": 90},
        "language": {"type": "string", "minLength": 2},
        "subtitle_language": {"type": "string", "minLength": 2},
        "aspect_ratios": {
          "type": "array",
          "items": {"enum": ["9:16", "16:9"]},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "creative_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "emotional_goal", "visual_style", "music_style"],
      "properties": {
        "audience": {"type": "string", "minLength": 1},
        "emotional_goal": {"type": "string", "minLength": 1},
        "visual_style": {"type": "string", "minLength": 1},
        "music_style": {"type": "string", "minLength": 1}
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "reference_image"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 1},
          "reference_image": {"type": "string", "minLength": 1}
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "duration_seconds", "purpose", "image_prompt", "motion_prompt", "narration", "music_cue", "transition"],
        "properties": {
          "id": {"type": "string", "pattern": "^shot_[0-9]{3}$"},
          "duration_seconds": {"type": "number", "minimum": 1, "maximum": 15},
          "purpose": {"type": "string", "minLength": 1},
          "image_prompt": {"type": "string", "minLength": 1},
          "motion_prompt": {"type": "string", "minLength": 1},
          "narration": {"type": "string", "minLength": 1},
          "subtitle_en": {"type": "string", "minLength": 1},
          "music_cue": {"type": "string", "minLength": 1},
          "transition": {"enum": ["cut", "crossfade", "fade"]}
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narration_enabled", "background_music_enabled", "music_ducking"],
      "properties": {
        "narration_enabled": {"type": "boolean"},
        "background_music_enabled": {"type": "boolean"},
        "music_ducking": {"type": "boolean"}
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "text"],
      "properties": {
        "enabled": {"type": "boolean"},
        "text": {"type": "string", "minLength": 1, "maxLength": 120},
        "duration_seconds": {"type": "number", "minimum": 2, "maximum": 8}
      }
    }
  }
}
